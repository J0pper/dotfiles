    output DP-2 enable mode 1920x1080@144.001Hz position -1920,0
}

profile dual-high-refresh-left {
    output DP-1 enable mode 1920x1080@239.759995Hz position 1920,0
    output DP-2 enable mode 1920x1080@144.001007Hz position 0,0
